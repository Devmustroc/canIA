# ==========================================
# DATABASE (PostgreSQL / Neon.tech)
# ==========================================
DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/cania?sslmode=require"

# ==========================================
# AUTHENTICATION (NextAuth v5 / Auth.js)
# ==========================================
# Generate a secret with: openssl rand -hex 32
AUTH_SECRET="your_nextauth_secret_here"

# OAuth Providers (Optional - Google / GitHub)
AUTH_GOOGLE_ID="your_google_client_id"
AUTH_GOOGLE_SECRET="your_google_client_secret"
AUTH_GITHUB_ID="your_github_client_id"
AUTH_GITHUB_SECRET="your_github_client_secret"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# AI INTEGRATIONS & ASSETS
# ==========================================
# Replicate API (AI Image Generation & Processing)
REPLICATE_API_TOKEN="r8_your_replicate_api_token"

# Anthropic API (Agentic AI Design Assistant)
ANTHROPIC_API_KEY="sk-ant-your_anthropic_api_key"
# Optional: override the model used by the design agent
ANTHROPIC_MODEL="claude-sonnet-5"

# Unsplash API (Stock Image Search)
UNSPLASH_ACCESS_KEY="your_unsplash_access_key"

# UploadThing (File & Image Uploads)
UPLOADTHING_SECRET="sk_live_your_uploadthing_secret"
UPLOADTHING_APP_ID="your_uploadthing_app_id"

# ==========================================
# STRIPE PAYMENTS (Optional)
# ==========================================
STRIPE_API_KEY="sk_test_your_stripe_api_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
